# POLAR-AI v2 Environment Variables
# Copy to .env — application works in demo mode with defaults

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=POLAR-AI
APP_ENV=development
DEBUG=true
SECRET_KEY=polar-ai-secret-key-change-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://polarai:polarai_password@localhost:5432/polarai_db
POSTGRES_USER=polarai
POSTGRES_PASSWORD=polarai_password
POSTGRES_DB=polarai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Data Mode ─────────────────────────────────────────────────────────────────
# auto  → use real data when credentials exist, else demo (recommended)
# live  → real data only, error if unavailable
# demo  → deterministic seed=42 synthetic data always
DATA_MODE=auto
DEMO_RANDOM_SEED=42
SCHEDULER_ENABLED=true

# ── LLM (all optional — app works without them) ───────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Copernicus Data Space (Sentinel-1 satellite imagery) ─────────────────────
# Register free at: https://dataspace.copernicus.eu/
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ── NASA Earthdata (NSIDC sea-ice CDR) ───────────────────────────────────────
# Register free at: https://urs.earthdata.nasa.gov/
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# ── Copernicus CDS (ERA5 weather reanalysis) ──────────────────────────────────
# Register free at: https://cds.climate.copernicus.eu/
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# ── Copernicus Marine (ocean currents/SST) ────────────────────────────────────
# Register free at: https://marine.copernicus.eu/
CMEMS_USERNAME=
CMEMS_PASSWORD=

# ── AIS Vessel Tracking ───────────────────────────────────────────────────────
# Providers: aisstream | barentswatch | marinetraffic | custom
# AISStream free tier: https://aisstream.io/ (WebSocket, free API key)
# BarentsWatch: https://www.barentswatch.no/bwapi/ (REST, free)
AIS_PROVIDER=
AIS_API_KEY=
AIS_API_URL=
AIS_WS_URL=
AIS_VESSEL_MMSI=   # Filter to specific vessel MMSI (optional)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5373

# ── Server ────────────────────────────────────────────────────────────────────
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=POLAR-AI

# ── Notes ─────────────────────────────────────────────────────────────────────
# Free sources (no credentials needed, always active):
#   - Open-Meteo NWP weather:  https://api.open-meteo.com/
#   - Open-Meteo Marine:       https://marine-api.open-meteo.com/
#   - NSIDC Sea Ice Index:     https://noaadata.apps.nsidc.org/NOAA/G02135/
#   - NIC Iceberg tracking:    https://usicecenter.gov/Products/AntarcIcebergs
